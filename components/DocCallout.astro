---
// The outcome callout: the brand's callout (hw-callout, which composePage adds) in purple, which
// marks the result and nothing else (EventRow.astro's next event): a purple tint with the brand
// corner, its text in weight 500 and its heading in purple.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="callout outcome">
  <h3>{title}</h3>
  <slot />
</div>
