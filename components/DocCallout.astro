---
// The outcome callout: InShort.astro's accent rule on the left of a tint with the brand corner on
// all four corners, here in purple, which marks the result and nothing else (EventRow.astro's next
// event; the heading 4.9:1 on the tint). Its text is set in weight 500. The base's .callout.outcome
// draws it.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="callout outcome">
  <h3>{title}</h3>
  <slot />
</div>
