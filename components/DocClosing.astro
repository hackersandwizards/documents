---
// The closing, kept whole so the sign-off never lands alone on a page: the closing text, the
// sign-off, then the sender's name. `tight` sets the name straight under the sign-off as one block,
// closer to the text: the proposal takes the tight closing, the rate card the open one, readers
// preferred each document's own.
interface Props {
  text: string;
  signOff: string;
  name: string;
  tight?: boolean;
}
const { text, signOff, name, tight = false } = Astro.props;
---

<div class:list={["closing", { tight }]}>
  <p>{text}</p>
  {tight ? (
    <p class="sign-off">
      {signOff}
      <br />
      {name}
    </p>
  ) : (
    <>
      <p class="sign-off">{signOff}</p>
      <p>{name}</p>
    </>
  )}
</div>

<style>
  .closing {
    margin-top: var(--closing-space);
    break-inside: avoid;
  }

  p {
    margin: 0 0 var(--closing-line);
  }

  .sign-off {
    margin-top: var(--closing-space-tight);
  }

  .tight {
    margin-top: var(--closing-space-tight);
  }

  .tight .sign-off {
    margin-top: var(--closing-sign-off-tight);
  }
</style>
