---
// The recipient card, the base's .prepared on Card.astro's tint surface: a label in caps, the company bold, then the
// person and the address, one per line.
interface Props {
  label: string;
  company: string;
  lines: string[];
  /** A second group under the address, such as the contact person. */
  contact?: { label: string; name: string };
}
const { label, company, lines, contact } = Astro.props;
---

<div class="prepared">
  <span class="label">{label}</span>
  <strong>{company}</strong>
  {lines.map((line) => (
    <>
      <br />
      {line}
    </>
  ))}
  {contact && (
    <>
      <span class="label">{contact.label}</span>
      {contact.name}
    </>
  )}
</div>
