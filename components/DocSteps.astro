---
// A sequence of dated steps: ruled rows (patterns.css .ruled-rows), the date in the h1 family's
// weight in purple, the step's name and one muted line beside it.
interface Props {
  steps: { when: string; name: string; text?: string }[];
}
const { steps } = Astro.props;
---

<ol class="timeline">
  {steps.map((step) => (
    <li>
      <span class="when">{step.when}</span>
      <div>
        <strong>{step.name}</strong>
        {step.text && <p>{step.text}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline {
    margin: var(--block-margin-loose);
    padding: 0;
    border-bottom: var(--rule) solid var(--line);
    list-style: none;
  }

  li {
    display: grid;
    background: none;
    grid-template-columns: var(--timeline-when) 1fr;
    gap: var(--space-grid);
    padding: var(--space-group) 0;
    border-top: var(--rule) solid var(--line);
    break-inside: avoid;
  }

  .when {
    font: var(--role-small);
    font-family: var(--heading-family);
    font-weight: var(--weight-heading);
    color: var(--result);
  }

  strong {
    display: block;
  }

  p {
    margin: var(--space-hair) 0 0;
    font: var(--role-small);
    color: var(--muted);
  }
</style>
