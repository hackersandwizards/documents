---
// The total row of a table: Price.astro's card amount in the h4 role on the teal band, a 12% tint
// under a strong teal rule, each figure in teal at 1.2 times. Teal marks money and hours alike
// (blind round 4, os/docs/tracking/2026-10-29-document-accents.md: quote 89.4, hours document 90.2).
// The label spans `span` columns; `note` fills a last text column in the small role.
interface Props {
  label: string;
  span: number;
  figures: string[];
  note?: string;
}
const { label, span, figures, note } = Astro.props;
---

<tr class="total">
  <td colspan={span}>{label}</td>
  {figures.map((figure) => (
    <td class="num">{figure}</td>
  ))}
  {note !== undefined && <td class="total-note">{note}</td>}
</tr>

<style>
  td {
    padding-top: var(--total-pad-top);
    padding-bottom: var(--space-cell);
    border-top: var(--rule-strong) solid var(--accent);
    border-bottom: 0;
    background: var(--accent-soft);
    font: var(--role-h4);
    letter-spacing: var(--tracking-h4);
    font-variant-numeric: tabular-nums;
  }

  .num {
    font-size: var(--figure-scale);
    text-align: right;
    white-space: nowrap;
    color: var(--accent);
  }

  .total-note {
    font: var(--role-small);
    color: var(--muted);
  }
</style>
