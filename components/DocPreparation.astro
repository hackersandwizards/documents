---
// The preparation document a trainer sends attendees before a training: the header, the eyebrow
// and title, a note with what to do by when, numbered steps as cards, a closing line. Each body is
// HTML on the document base (code, pre, .grid-2 with .label columns, .small, .muted; in the note a
// `<p class="it-line">` with `<span class="chip it-chip">` for the line to the IT department).
import DocHeader from "./DocHeader.astro";

interface Props {
  lang?: "de" | "en";
  title: string;
  /** The tag in the header, e.g. "Vorbereitung". */
  kind: string;
  /** Lines under the tag, such as the training's dates and place. */
  meta?: string[];
  eyebrow?: string;
  heading: string;
  note?: { label: string; html: string };
  steps: { title: string; html: string }[];
  /** The closing line under the steps, as HTML. */
  closing?: string;
}
const { lang = "de", kind, meta, eyebrow, heading, note, steps, closing } = Astro.props;
---

<DocHeader kind={kind} meta={meta} lang={lang} />
<div class="preparation">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h1>{heading}</h1>
  {
    note && (
      <div class="note">
        <span class="label">{note.label}</span>
        <Fragment set:html={note.html} />
      </div>
    )
  }
  {
    steps.map((step, i) => (
      <div class="card keep">
        <h3>
          <span class="step">{i + 1}</span> {step.title}
        </h3>
        <Fragment set:html={step.html} />
      </div>
    ))
  }
  {closing && <div class="closing" set:html={closing} />}
</div>

<style>
  .preparation :global(.card) {
    margin-bottom: var(--step-space);
    padding: var(--note-pad);
  }

  .preparation :global(.card h3) {
    margin-top: 0;
  }

  .note {
    padding: var(--note-pad);
  }

  .preparation :global(pre) {
    margin: var(--step-code-margin);
    padding: var(--step-code-pad);
  }

  .preparation :global(code) {
    font-variant-ligatures: none;
    white-space: nowrap;
  }

  .preparation :global(pre code) {
    white-space: pre;
    font-size: var(--step-code-size);
  }

  .preparation :global(.grid-2 pre) {
    margin: var(--step-code-margin-grid);
  }

  .preparation :global(.grid-2 > div) {
    display: flex;
    flex-direction: column;
  }

  .preparation :global(.grid-2 > div > pre) {
    margin-top: auto;
  }

  .preparation :global(.it-line) {
    margin-top: var(--space-heading);
  }

  .preparation :global(.it-chip) {
    margin: 0 var(--space-cell) 0 0;
    padding: var(--chip-pad-slim);
    background: var(--result);
    color: var(--on-dark);
    font-weight: var(--weight-semibold);
  }

  .step {
    display: inline-block;
    min-width: var(--step-number-width);
    margin-right: var(--space-heading);
    padding: 0 var(--space-heading);
    background: var(--accent);
    color: var(--on-dark);
    text-align: center;
  }

  .closing {
    margin-top: var(--step-space);
  }
</style>
