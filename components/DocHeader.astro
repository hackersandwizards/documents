---
// The document header, the twin of the website's Nav.astro: a bar in the page tint across the
// paper, the gradient strip on top, a rule under it, the lockup left and the document tag right.
// The lockup is this package's own, inlined as a data URI, so the header renders in any app.
import lockupSvg from "@hackersandwizards/brand/logos/lockup.svg?raw";

interface Props {
  /** The document kind in the tag, e.g. "Honorarsätze". */
  kind: string;
  /** Sets the imprint under the lockup, for a business letter h&w issues as the GmbH to a named
   * recipient. § 35a Abs. 1 GmbHG asks for legal form, seat, register court and number and every
   * managing director; the address and the VAT ID are what a buyer's purchase order needs. Each
   * fact appears once: "Sitz und Registergericht Hamburg" names the city for both. Three lines in
   * place of five and a mail address: a blind panel (Claude, Codex; procurement, engineering lead;
   * two runs) scored them 45.5 of 50 against 42.1, the imprint in the page-1 footer 46.3, a tie
   * inside the noise of 4 that went to the header, which needs no exception in the margin boxes
   * (2026-11-01). */
  legal?: boolean;
  /** Lines under the tag, such as the date and the validity. */
  meta?: string[];
  /** The imprint's language. */
  lang?: "de" | "en";
  /** Sets the tag as a link to this address, such as the website the tag names. */
  href?: string;
}
const { kind, legal = false, meta = [], lang = "de", href } = Astro.props;
const imprint = {
  de: [
    "hackers&wizards GmbH, Osterstraße 95, 20259 Hamburg",
    "Sitz und Registergericht Hamburg, HRB 198840, USt-IdNr. DE463065921",
    "Geschäftsführer: Benedikt Stemmildt, Stefan Munz",
  ],
  en: [
    "hackers&wizards GmbH, Osterstraße 95, 20259 Hamburg, Germany",
    "Registered office and court Hamburg, HRB 198840, VAT ID DE463065921",
    "Managing Directors: Benedikt Stemmildt, Stefan Munz",
  ],
}[lang];
// Base64 rather than Vite's URL-encoded SVG inline.
const lockup = `data:image/svg+xml;base64,${Buffer.from(lockupSvg).toString("base64")}`;
---

<header class="doc-header">
  <div class="brand">
    <div class="brand-name">
      <img src={lockup} alt="hackers&wizards" />
    </div>
    {legal && (
      <div class="company-meta">
        {imprint.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </div>
    )}
  </div>
  <div class="doc-meta">
    <span class="doc-tag">{href ? <a class="doc-tag-link" href={href}>{kind}</a> : kind}</span>
    {meta.map((line) => (
      <>
        <br />
        {line}
      </>
    ))}
  </div>
</header>

<style>
  .doc-header {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--header-gap);
    min-height: calc(var(--header-row) + var(--strip));
    margin-bottom: var(--header-gap);
    padding: calc(var(--strip) + var(--header-pad)) 0 var(--header-pad);
  }

  .doc-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--side));
    border-top: var(--strip) solid transparent;
    border-bottom: var(--rule) solid var(--line);
    background:
      var(--gradient) top / 100% var(--strip) no-repeat border-box,
      var(--tint) padding-box;
  }

  /* The lockup at the print logo's height, the header row's mark, which sets its wordmark at 952 of
     the lockup's 1489 units, 1.25 times the print wordmark: at the print wordmark's own height the
     letters were hard to read at 80% zoom. The imprint lines sit under it. */
  .brand {
    --lockup-height: var(--logo);
    display: block;
  }

  .brand-name {
    display: flex;
  }

  .brand-name img {
    width: auto;
    height: var(--lockup-height);
    flex: none;
    translate: none;
  }

  .company-meta {
    margin-top: var(--space-imprint);
    font: var(--role-small);
    color: var(--muted);
  }

  .doc-meta {
    max-width: var(--header-meta-width);
    font: var(--role-small);
    text-align: right;
    color: var(--muted);
  }

  .doc-header a {
    color: inherit;
    text-decoration: none;
  }

  /* The brand's pill in capitals (hw-pill data-caps, which composePage adds). A filled CTA shape
     was dropped: blind reviewers read it as a button. */
  .doc-tag {
    margin-bottom: var(--space-tag);
    --hw-pill-pad: var(--chip-pad);
  }
</style>
