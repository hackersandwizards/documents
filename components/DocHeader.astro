---
// The document header, the twin of the website's Nav.astro: a bar in the page tint across the
// paper, the gradient strip on top, a rule under it, the lockup left and the document tag right.
// The lockup is this package's own, inlined as a data URI, so the header renders in any app.
import lockupSvg from "@hackersandwizards/brand/logos/lockup.svg?raw";

interface Props {
  /** The document kind in the tag, e.g. "Honorarsätze". */
  kind: string;
  /** Names the legal entity and its seat under the wordmark, for documents h&w issues as the GmbH
   * (§ 35a GmbHG puts legal form and seat on business letters, not on the logo). */
  legal?: boolean;
  /** The rest of the imprint under the entity line; a Markdown contract names the parties in its
   * body and keeps only the entity line. */
  imprint?: boolean;
  /** Lines under the tag, such as the date and the validity. */
  meta?: string[];
  /** The imprint's language. */
  lang?: "de" | "en";
  /** Sets the tag as a link to this address, such as the website the tag names. */
  href?: string;
  /** Replaces the entity line and the imprint lines of `lang` below. */
  imprintLines?: string[];
  /** The imprint's mail address. */
  mail?: string;
}
const {
  kind,
  legal = false,
  imprint = legal,
  meta = [],
  lang = "de",
  href,
  mail = "summon@hackersandwizards.dev",
} = Astro.props;
const [entity, ...imprintLines] = Astro.props.imprintLines ?? {
  de: [
    "hackers&wizards GmbH, Sitz Hamburg",
    "Geschäftsführer: Benedikt Stemmildt & Stefan Munz",
    "Osterstraße 95, 20259 Hamburg",
    "AG Hamburg HRB 198840, USt-IdNr. DE463065921",
  ],
  en: [
    "hackers&wizards GmbH, registered office Hamburg",
    "Managing Directors: Benedikt Stemmildt & Stefan Munz",
    "Osterstraße 95, 20259 Hamburg, Germany",
    "AG Hamburg HRB 198840, VAT ID DE463065921",
  ],
}[lang];
// Base64 rather than Vite's URL-encoded SVG inline.
const lockup = `data:image/svg+xml;base64,${Buffer.from(lockupSvg).toString("base64")}`;
---

<header class="doc-header">
  <div class="brand">
    <div class="brand-name">
      <img src={lockup} alt="hackers&wizards" />
    </div>
    {legal && (
      <div class="company-meta">
        {entity}
        {imprint && (
          <>
            {imprintLines.map((line) => (
              <>
                <br />
                {line}
              </>
            ))}
            <br />
            <a href={`mailto:${mail}`}>{mail}</a>
          </>
        )}
      </div>
    )}
  </div>
  <div class="doc-meta">
    <span class="doc-tag">{href ? <a href={href}>{kind}</a> : kind}</span>
    {meta.map((line) => (
      <>
        <br />
        {line}
      </>
    ))}
  </div>
</header>

<style>
  .doc-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8mm;
    min-height: calc(var(--print-row) + var(--print-strip));
    margin-bottom: 8mm;
    padding: calc(var(--print-strip) + 8pt) 0 8pt;
  }

  .doc-header::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--side));
    border-top: var(--print-strip) solid transparent;
    border-bottom: var(--print-rule) solid var(--line);
    background:
      var(--gradient) top / 100% var(--print-strip) no-repeat border-box,
      var(--color-bg) padding-box;
  }

  /* The lockup at the print logo's height, the header row's mark, which sets its wordmark at 952 of
     the lockup's 1489 units, 1.25 times the print wordmark: at the print wordmark's own height the
     letters were hard to read at 80% zoom. The imprint lines sit under it. */
  .brand {
    --lockup-height: var(--print-logo);
    display: block;
  }

  .brand-name {
    display: flex;
  }

  .brand-name img {
    width: auto;
    height: var(--lockup-height);
    flex: none;
    translate: none;
  }

  .company-meta {
    margin-top: 1.5pt;
    font: var(--role-small);
    color: var(--muted);
  }

  .doc-meta {
    max-width: 70mm;
    font: var(--role-small);
    text-align: right;
    color: var(--muted);
  }

  .doc-header a {
    color: inherit;
    text-decoration: none;
  }

  /* The website's category pill (TrainingList.astro .tl-chip): in print the 40% teal tint,
     teal-light, under ink, weight 500. A filled CTA shape was dropped: blind reviewers read it as a button. */
  .doc-tag {
    display: inline-block;
    margin-bottom: 3pt;
    padding: var(--print-chip-pad);
    border-radius: var(--radius-pill);
    background: var(--color-teal-light);
    font: var(--role-small);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }
</style>
