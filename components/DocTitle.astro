---
// A document's title block: the eyebrow (the website's label-caps), the h1, and an optional
// lead (SectionHeader.astro's lead role in muted ink).
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

{eyebrow && <span class="eyebrow">{eyebrow}</span>}
<h1>{title}</h1>
{subtitle && <p class="subtitle">{subtitle}</p>}

<style>
  .eyebrow {
    display: block;
    margin-bottom: 4pt;
    font: var(--role-small);
    font-family: var(--type-label-family);
    font-weight: var(--type-label-weight);
    letter-spacing: var(--type-label-tracking);
    text-transform: var(--type-label-case);
    color: var(--teal-dark);
  }

  .subtitle {
    max-width: 150mm;
    margin-bottom: 10pt;
    font: var(--role-lead);
    color: var(--muted);
  }
</style>
