---
// A document's title block: the eyebrow (the website's label-caps), the h1, and an optional
// lead (SectionHeader.astro's lead role in muted ink).
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

{eyebrow && <span class="eyebrow">{eyebrow}</span>}
<h1>{title}</h1>
{subtitle && <p class="subtitle">{subtitle}</p>}

<style>
  .subtitle {
    max-width: var(--measure);
    margin-bottom: var(--subtitle-space-after);
    font: var(--role-lead);
    color: var(--muted);
  }
</style>
