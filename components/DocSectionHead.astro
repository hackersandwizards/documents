---
// A section's head, kept with what follows: an optional section label (TrainingList.astro's group
// title, the h4 role's size in mono 600 capitals after a teal square), then the h2.
interface Props {
  label?: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div class="section-head">
  {label && <span class="section-label">{label}</span>}
  <h2>{title}</h2>
</div>

<style>
  .section-head {
    margin-top: 7mm;
    break-inside: avoid;
    break-after: avoid;
  }

  h2 {
    margin-top: 0;
  }

  .section-label {
    display: block;
    margin: 15pt 0 6pt;
    font: var(--role-h4);
    font-weight: 600;
    letter-spacing: var(--type-label-tracking);
    text-transform: uppercase;
    color: var(--ink);
    break-after: avoid;
  }

  .section-label::before {
    content: "";
    display: inline-block;
    width: var(--print-swatch);
    height: var(--print-swatch);
    margin-right: 7.5pt;
    vertical-align: round(calc(0.365em - var(--print-swatch) / 2), 1px);
    background: var(--teal);
  }
</style>
