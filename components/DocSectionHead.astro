---
// A section's head, kept with what follows: an optional section label (TrainingList.astro's group
// title, the h4 role's size in mono 600 capitals after a teal square), then the h2.
interface Props {
  label?: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div class="section-head">
  {label && <span class="section-label">{label}</span>}
  <h2>{title}</h2>
</div>

<style>
  .section-head {
    margin-top: var(--section-space);
    break-inside: avoid;
    break-after: avoid;
  }

  h2 {
    margin-top: 0;
  }

  .section-label {
    display: block;
    margin: var(--section-label-margin);
    font: var(--role-h4);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink);
    break-after: avoid;
  }

  .section-label::before {
    content: "";
    display: inline-block;
    width: var(--swatch);
    height: var(--swatch);
    margin-right: var(--swatch-gap);
    vertical-align: round(calc(var(--caps-middle) - var(--swatch) / 2), var(--pixel));
    background: var(--accent);
  }
</style>
