---
// A Markdown document (print-pdf, the delivery and trainer briefings, a report): the header, then
// the body as DocProse. The body brings no style of its own: DocProse drops every style attribute
// and fails on a style element; a look the base lacks is a variant or a type of the engine.
import DocHeader from "./DocHeader.astro";
import DocProse from "./DocProse.astro";

interface Props {
  /** The document kind in the header tag, e.g. "Delivery Briefing". */
  kind: string;
  legal?: boolean;
  /** The imprint's language. */
  lang?: "de" | "en";
  meta?: string[];
  /** The body: sanitized HTML, its eyebrow, title and lead already in place. */
  html: string;
}
const { kind, legal, lang, meta, html } = Astro.props;
---

<DocHeader kind={kind} legal={legal} lang={lang} meta={meta} />
<DocProse html={html} />
