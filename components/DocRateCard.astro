---
// The personal rate card, composed from the document components. The rates and the terms are props:
// this package is public, so no rate or term of ours is written here.
import DocCard from "./DocCard.astro";
import DocClosing from "./DocClosing.astro";
import DocHeader from "./DocHeader.astro";
import DocLead from "./DocLead.astro";
import DocPriceTable from "./DocPriceTable.astro";
import DocRecipient from "./DocRecipient.astro";
import DocTitle from "./DocTitle.astro";
import { fill } from "../scripts/fill";

// The rate card's own words; `labels` replaces any of them, `{name}` marks a value filled in.
const TEXT = {
  kind: "Honorarsätze",
  date: "Datum: {date}",
  validUntil: "Gültig bis: {validUntil}",
  eyebrow: "Honorarsätze {year}",
  title: "Persönliche Honorarsätze {personName}",
  preparedFor: "Erstellt für",
  rates: "Honorare",
  columns: ["Leistung", "Einheit", "Honorar netto"],
  scope: "Leistungsspektrum",
  terms: "Konditionen",
  /** The running header, left and right. */
  runningBrand: "hackers&wizards GmbH",
  runningTitle: "Honorarsätze {personName}",
};

interface Props {
  personName: string;
  date: string;
  validUntil: string;
  /** Year in the eyebrow, e.g. "2026". */
  year: string;
  /** The salutation's opening word and the recipient's first name, e.g. "Hallo" and "Anna". */
  opener: string;
  recipientFirstName: string;
  greeting: string;
  client: {
    company: string;
    shortName: string;
    recipientName: string;
    street: string;
    zip: string;
    city: string;
  };
  /** One row per rate: the item, its explanation, the unit and the net figure. */
  rates: { item: string; detail: string; unit: string; rate: string }[];
  /** The paragraphs of the terms panel. */
  terms: string[];
  scope: string[];
  closing: string;
  signOff: string;
  /** Replaces any of the rate card's own words (TEXT above). */
  labels?: Partial<typeof TEXT>;
}
const p = Astro.props;
const t = { ...TEXT, ...p.labels };
// The running header and footer: the base styles the margin boxes, a document names their content.
// Page 1 carries the document header, so the running head is off there again: the base's `@page
// :first` loses to this later rule, and on page 1's zero top margin it printed clipped, invisible
// but in the PDF's text.
const running = `@page {
  @top-left { content: ${JSON.stringify(t.runningBrand)}; }
  @top-right { content: ${JSON.stringify(fill(t.runningTitle, p))}; }
  @bottom-left { content: ${JSON.stringify(p.client.shortName)}; }
}
@page :first { @top-left { content: none; } @top-right { content: none; } }`;
---

<style is:inline set:html={running} />
<DocHeader kind={t.kind} legal meta={[fill(t.date, p), fill(t.validUntil, p)]} />
<DocTitle eyebrow={fill(t.eyebrow, p)} title={fill(t.title, p)} />
<DocLead>
  <p>
    {p.opener} {p.recipientFirstName},
  </p>
  <p>{p.greeting}</p>
  <DocRecipient
    slot="aside"
    label={t.preparedFor}
    company={p.client.company}
    lines={[p.client.recipientName, p.client.street, `${p.client.zip} ${p.client.city}`]}
  />
</DocLead>

<h2>{t.rates}</h2>
<DocPriceTable
  sums
  columns={[
    { label: t.columns[0], width: "55%" },
    { label: t.columns[1], width: "20%" },
    { label: t.columns[2], width: "25%", num: true },
  ]}
  rows={p.rates.map((r) => ({ item: r.item, detail: r.detail, cells: [r.unit, r.rate] }))}
/>

<DocCard title={t.scope}>
  <ul>
    {p.scope.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</DocCard>

<DocCard title={t.terms} tint dense>
  {p.terms.map((text) => (
    <p>{text}</p>
  ))}
</DocCard>

<DocClosing text={p.closing} signOff={p.signOff} name={p.personName} />
