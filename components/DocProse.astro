---
// Prose: the element rules for Markdown bodies (pandoc and Astro's markdown output) and other free
// text, the print twins of the website's typography: headings in mono, ruled tables, the terminal
// panel for code; lists take the document base's own rules. The HTML comes in sanitized; this sets
// it on the page.
// Each rule keeps an element's specificity (:where), so a class in the body, such as .subtitle or
// .signature-line, still wins as it does over the document base's element rules.
import { proseHtml } from "../scripts/prose";

interface Props {
  html: string;
}
const html = proseHtml(Astro.props.html);
---

<div class="doc-prose">
  <Fragment set:html={html} />
</div>

<style>
  :global(:where(.doc-prose) h1),
  :global(:where(.doc-prose) h2),
  :global(:where(.doc-prose) h3),
  :global(:where(.doc-prose) h4) {
    color: var(--ink);
    text-wrap: balance;
    break-after: avoid;
  }

  /* A paragraph that is one bold run is a label heading the text under it, as a briefing writes
     each question: it stays on the page with that text. */
  :global(:where(.doc-prose) p:has(> strong:only-child)) {
    break-after: avoid;
  }

  :global(:where(.doc-prose) h1) {
    margin-bottom: var(--h1-space-after);
    font: var(--role-h1);
    letter-spacing: var(--tracking-h1);
  }

  :global(:where(.doc-prose) h2) {
    margin: var(--h2-margin);
    font: var(--role-h2);
    letter-spacing: var(--tracking-h2);
  }

  :global(:where(.doc-prose) h3) {
    margin: var(--h3-margin);
    font: var(--role-h3);
    letter-spacing: var(--tracking-h3);
  }

  :global(:where(.doc-prose) h4) {
    margin: var(--h4-margin);
    font: var(--role-h4);
    letter-spacing: var(--tracking-h4);
  }

  :global(:where(.doc-prose) p) {
    margin: 0 0 var(--space-paragraph);
  }

  :global(:where(.doc-prose) strong),
  :global(:where(.doc-prose) b) {
    font-weight: var(--weight-semibold);
  }

  :global(:where(.doc-prose) a) {
    color: var(--accent-text);
    text-decoration: underline;
    text-decoration-thickness: var(--underline);
    text-underline-offset: var(--underline-offset);
  }

  :global(:where(.doc-prose) hr) {
    margin: var(--rule-margin);
    border: 0;
    border-top: var(--rule) solid var(--line);
  }

  :global(:where(.doc-prose) table) {
    width: 100%;
    margin: var(--table-margin);
    border-collapse: collapse;
    font: var(--role-small);
  }

  :global(:where(.doc-prose) thead) {
    display: table-header-group;
  }

  :global(:where(.doc-prose) tr) {
    break-inside: avoid;
  }

  :global(:where(.doc-prose) th) {
    padding: var(--cell-pad);
    border-bottom: var(--rule) solid var(--line);
    font: var(--role-label);
    letter-spacing: var(--tracking-caps);
    text-align: left;
    text-transform: var(--case-label);
    color: var(--muted);
  }

  :global(:where(.doc-prose) td) {
    padding: var(--cell-pad);
    border-bottom: var(--rule) solid var(--line);
    vertical-align: top;
  }

  :global(:where(.doc-prose) th:last-child),
  :global(:where(.doc-prose) td:last-child) {
    padding-right: 0;
  }

  :global(:where(.doc-prose) blockquote) {
    margin: var(--callout-margin);
    padding-left: var(--space-list);
    border-left: var(--rule-accent) solid var(--result);
    color: var(--muted);
    break-inside: avoid;
  }

  :global(:where(.doc-prose) dl) {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--dl-gap);
    margin: var(--block-margin);
    font: var(--role-small);
  }

  :global(:where(.doc-prose) dt) {
    color: var(--muted);
  }

  :global(:where(.doc-prose) pre) {
    margin: var(--callout-margin);
    padding: var(--card-pad);
    border: var(--rule) solid var(--night-line);
    border-radius: var(--radius);
    background: var(--night-raised);
    font: var(--role-code);
    color: var(--night-ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    break-inside: avoid;
  }

  :global(:where(.doc-prose) pre .prompt) {
    color: var(--prompt);
  }

  :global(:where(.doc-prose) pre),
  :global(:where(.doc-prose) code) {
    font-variant-ligatures: none;
  }

  :global(:where(.doc-prose) code) {
    font-family: var(--code-family);
  }

  :global(:where(.doc-prose) pre code) {
    color: inherit;
  }

  :global(:where(.doc-prose) blockquote > :last-child) {
    margin-bottom: 0;
  }
</style>
