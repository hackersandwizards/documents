{
  "model": "fable",
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "subagentPromptCacheTtl": "1h",
  "claudeMdExcludes": ["/Users/*/.claude/rules/**", "/home/*/.claude/rules/**"],
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.githooks/session-start\""
          }
        ]
      }
    ]
  }
}
