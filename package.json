{
  "name": "@hackersandwizards/documents",
  "version": "0.6.1",
  "private": true,
  "description": "The hackers&wizards document engine: the document base, the document components, composing a component to standalone HTML and rendering it to PDF with headless Chrome.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./document.css": "./document.css",
    "./components/*": "./components/*",
    "./compose": "./scripts/compose.ts",
    "./render-pdf": "./scripts/render-pdf.ts",
    "./onepager": "./scripts/onepager.ts",
    "./onepager.css": "./onepager.css",
    "./handout.css": "./handout.css",
    "./survey-readout": "./scripts/survey-readout.ts"
  },
  "bin": {
    "documents-compose": "scripts/compose.ts",
    "documents-privacy": "scripts/privacy.ts",
    "documents-styles": "scripts/styles.ts"
  },
  "files": [
    "tokens.css",
    "document.css",
    "onepager.css",
    "readout.css",
    "handout.css",
    "components",
    "scripts/onepager.ts",
    "scripts/survey-readout.ts",
    "scripts/fill.ts",
    "scripts/compose.ts",
    "scripts/elements.ts",
    "scripts/render-pdf.ts",
    "scripts/root.ts",
    "scripts/privacy.ts",
    "scripts/prose.ts",
    "scripts/styles.ts",
    "scripts/samples.ts",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "cd catalog && bun --bun astro build",
    "check": "scaffolding check",
    "test": "bun test",
    "check:tests": "bun run test",
    "check:markers": "brand-markers dist/types/angebot-ohne-preise/index.html dist/types/angebot/index.html dist/types/certificate/index.html dist/types/delivery-briefing/index.html dist/types/dokument/index.html dist/types/geheimhaltungsvereinbarung/index.html dist/types/honorarsaetze/index.html dist/types/leistungsnachweis-pauschal/index.html dist/types/onepager/index.html dist/types/quote/index.html dist/types/survey-readout/index.html dist/types/trainer-briefing/index.html dist/types/zertifikat/index.html",
    "check:privacy": "bun scripts/privacy.ts",
    "check:colours": "brand-colours",
    "check:elements": "brand-elements",
    "check:admin": "admin-check",
    "check:staged": "check-staged",
    "lint": "bun --bun eslint --cache --concurrency=auto .",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write ."
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "astro": "^7.4.4",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v0.4.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.30.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v0.3.2",
    "@types/bun": "1.4.4",
    "astro": "7.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "admin": {
    "products": [
      {
        "label": "Catalog",
        "href": "https://hackersandwizards.github.io/documents/catalog/"
      }
    ]
  },
  "scaffolding": {
    "uniqueNames": [
      "GET"
    ],
    "skip": {
      "test": "the tests read the type pages the catalog build writes, so they run after it, as the first of this repository's own steps"
    },
    "check": [
      "check:tests",
      "check:markers",
      "check:privacy",
      "check:colours",
      "check:elements",
      "check:admin"
    ]
  }
}
