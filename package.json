{
  "name": "@hackersandwizards/documents",
  "version": "1.14.2",
  "private": true,
  "description": "The hackers&wizards document engine: the document base, the document components, composing a component to standalone HTML and rendering it to PDF with headless Chrome.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./document.css": "./document.css",
    "./components/*": "./components/*",
    "./compose": "./scripts/compose.ts",
    "./render-pdf": "./scripts/render-pdf.ts",
    "./onepager": "./scripts/onepager.ts",
    "./onepager.css": "./onepager.css",
    "./handout.css": "./handout.css",
    "./handout": "./scripts/handout.ts",
    "./survey-readout": "./scripts/survey-readout.ts"
  },
  "bin": {
    "documents-compose": "scripts/compose.ts",
    "documents-privacy": "scripts/privacy.ts",
    "documents-styles": "scripts/styles.ts"
  },
  "files": [
    "tokens.css",
    "document.css",
    "onepager.css",
    "readout.css",
    "handout.css",
    "components",
    "scripts/onepager.ts",
    "scripts/survey-readout.ts",
    "scripts/fill.ts",
    "scripts/handout.ts",
    "scripts/compose.ts",
    "scripts/elements.ts",
    "scripts/render-pdf.ts",
    "scripts/root.ts",
    "scripts/privacy.ts",
    "scripts/prose.ts",
    "scripts/styles.ts",
    "scripts/samples.ts",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "cd catalog && bun --bun astro build",
    "check": "scaffolding check",
    "test": "bun test",
    "check:tests": "bun run test",
    "check:markers": "brand-markers $(grep -l '<ul' dist/types/*/index.html)",
    "check:privacy": "bun scripts/privacy.ts",
    "check:colours": "brand-colours",
    "check:copies": "brand-copies",
    "check:elements": "brand-elements",
    "check:retired": "brand-retired dist",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write ."
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "@hackersandwizards/scaffolding": "*",
    "astro": "^7.4.4",
    "vite": "^8.3.5"
  },
  "peerDependenciesMeta": {
    "@hackersandwizards/brand": {
      "optional": true
    },
    "@hackersandwizards/scaffolding": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.5",
    "postcss-selector-parser": "7.1.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.10.3",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.28.1",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v2.16.0",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.7",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "puppeteer-core": "25.16.0",
    "stylelint": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "scaffolding": {
    "styles": [
      "./document.css",
      "./handout.css"
    ],
    "uniqueNames": [
      "GET"
    ],
    "skip": {
      "test": "the tests read the type pages the catalog build writes, so they run after it, as the first of this repository's own steps"
    },
    "check": [
      "check:tests",
      "check:markers",
      "check:privacy",
      [
        "check:colours",
        "check:copies",
        "check:retired"
      ],
      "check:elements"
    ]
  },
  "dependencies": {
    "entities": "9.0.0"
  }
}
