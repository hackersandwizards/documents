{
  "name": "@hackersandwizards/documents",
  "version": "1.30.8",
  "private": true,
  "description": "The hackers&wizards document engine: the document base, the document components, composing a component to standalone HTML and rendering it to PDF with headless Chrome.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "exports": {
    "./tokens.css": "./tokens.css",
    "./document.css": "./document.css",
    "./components/*": "./components/*",
    "./compose": "./scripts/compose.ts",
    "./render-pdf": "./scripts/render-pdf.ts",
    "./compose-document": "./scripts/compose-document.ts",
    "./document-css": "./scripts/document-css.ts",
    "./font-faces": "./scripts/font-faces.ts",
    "./assert-brand-fonts": "./scripts/assert-brand-fonts.ts",
    "./inline-images": "./scripts/inline-images.ts",
    "./render-handout-pdf": "./scripts/render-handout-pdf.ts",
    "./onepager": "./scripts/onepager.ts",
    "./onepager.css": "./onepager.css",
    "./handout.css": "./handout.css",
    "./handout": "./scripts/handout.ts",
    "./survey-readout": "./scripts/survey-readout.ts"
  },
  "bin": {
    "documents-compose": "scripts/compose.ts",
    "documents-privacy": "scripts/privacy.ts",
    "documents-styles": "scripts/styles.ts"
  },
  "files": [
    "tokens.css",
    "document.css",
    "onepager.css",
    "readout.css",
    "handout.css",
    "components",
    "scripts/compact-styles.ts",
    "scripts/deny-patterns.ts",
    "scripts/encode-face.ts",
    "scripts/onepager.ts",
    "scripts/page2-block.ts",
    "scripts/survey-readout.ts",
    "scripts/score-bands.ts",
    "scripts/fill.ts",
    "scripts/handout.ts",
    "scripts/compose.ts",
    "scripts/elements.ts",
    "scripts/render-pdf.ts",
    "scripts/chrome-pipe.ts",
    "scripts/chrome-profile.ts",
    "scripts/compose-document.ts",
    "scripts/document-css.ts",
    "scripts/font-faces.ts",
    "scripts/assert-brand-fonts.ts",
    "scripts/inline-images.ts",
    "scripts/kept-process.ts",
    "scripts/pdf-character-map.ts",
    "scripts/print-chrome.ts",
    "scripts/process-protocol.ts",
    "scripts/readout-scales.ts",
    "scripts/readout-slides.ts",
    "scripts/readout-text.ts",
    "scripts/render-handout-pdf.ts",
    "scripts/root.ts",
    "scripts/privacy.ts",
    "scripts/prose.ts",
    "scripts/prune.ts",
    "scripts/styles.ts",
    "scripts/stable-pdf.ts",
    "scripts/samples.ts",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "cd catalog && bun --bun astro dev",
    "catalog": "bun run dev",
    "build": "check-lock sh -c 'cd catalog && bun --bun astro build'",
    "check": "scaffolding check",
    "test": "scaffolding test",
    "mutation": "SCAFFOLDING_MUTATION_BUN=1 scaffolding-mutation",
    "check:markers": "brand-markers $(grep -l '<ul' dist/types/*/index.html)",
    "check:privacy": "bun scripts/privacy.ts",
    "check:staged": "check-staged"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=2.17.0",
    "@hackersandwizards/scaffolding": "*",
    "@hackersandwizards/testimonials": "*",
    "astro": "^7.4.4",
    "vite": "^8.3.5"
  },
  "peerDependenciesMeta": {
    "@hackersandwizards/brand": {
      "optional": true
    },
    "@hackersandwizards/scaffolding": {
      "optional": true
    },
    "@hackersandwizards/testimonials": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.9",
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@hackersandwizards/admin": "git+https://github.com/hackersandwizards/admin.git#v1.40.2",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v2.29.3",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.42.0",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.13",
    "astrobook": "0.13.3",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "puppeteer-core": "25.18.1",
    "stylelint": "18.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8"
  },
  "prettier": "@hackersandwizards/scaffolding/prettier",
  "scaffolding": {
    "typecheck": "tsc --noEmit && bun --bun astro check --root .",
    "styles": [
      "./document.css",
      "./handout.css"
    ],
    "browserTest": "test/pages",
    "brand": {
      "retired": [
        "dist"
      ]
    },
    "fullOnly": {
      "check:privacy": "scans the built type pages for private data"
    },
    "check": [
      "browser-test",
      "check:privacy",
      "retired",
      "elements"
    ]
  },
  "dependencies": {
    "entities": "9.0.0",
    "subset-font": "2.9.0",
    "woff2-encoder": "2.0.0"
  },
  "admin": {
    "label": "Document engine"
  }
}
