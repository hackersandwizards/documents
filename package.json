{
  "name": "@hackersandwizards/documents",
  "version": "0.1.2",
  "private": true,
  "description": "The hackers&wizards document engine: the document base, the document components, composing a component to standalone HTML and rendering it to PDF with headless Chrome.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.0"
  },
  "exports": {
    "./document.css": "./document.css",
    "./components/*": "./components/*",
    "./compose": "./scripts/compose.ts",
    "./render-pdf": "./scripts/render-pdf.ts"
  },
  "bin": {
    "documents-compose": "scripts/compose.ts"
  },
  "files": [
    "document.css",
    "components",
    "scripts/compose.ts",
    "scripts/render-pdf.ts",
    "LICENSE"
  ],
  "scripts": {
    "preinstall": "node .claude/skills/engineering/only-bun.cjs",
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun .claude/skills/engineering/check-unique-names.ts && bun test && bun scripts/specimen.ts --check && brand-colours",
    "lint": "eslint --cache --concurrency=auto .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint --cache --concurrency=auto . --fix && prettier --write .",
    "specimen": "bun scripts/specimen.ts",
    "check:staged": "bun .claude/skills/engineering/check-staged.ts"
  },
  "peerDependencies": {
    "@hackersandwizards/brand": "*",
    "astro": "^7.4.4",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v0.10.1",
    "@types/bun": "1.4.4",
    "astro": "7.4.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
