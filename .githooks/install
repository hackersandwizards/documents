#!/bin/sh
# bun install --frozen-lockfile under the lock the gate and a build hold (node_modules/.check.lock),
# for the post-merge and post-checkout hooks, the SessionStart hook and the MCP server's start.
# Silent when it installs; a skip or a failure goes to stderr with what to run. Never to stdout,
# which is an MCP server's protocol channel.
cd "$(git rev-parse --show-toplevel)" || exit 1
lock=node_modules/.check.lock
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
if [ -x node_modules/.bin/check-lock ] || grep -q '"check-lock":' package.json 2>/dev/null; then
  # Without waiting behind a gate or a build, which a merge or a session start would otherwise do
  # for minutes: a gate installs as its first step; after a build, the next gate or session start
  # installs. Another install holding the lock is waited for, as check-lock does for its own command.
  CHECK_LOCK_WAIT_MS=0 bun run --silent check-lock bun install --frozen-lockfile </dev/null >"$log" 2>&1
else
  # No check-lock before the first install: the lock is taken as check-lock takes it, a hard link of
  # a complete file naming the same command, so another first install, or check-lock once linked,
  # waits for this one.
  holder() { sed -n 's/^{"pid":\([0-9]*\).*/\1/p' "$1" 2>/dev/null; }
  mkdir -p node_modules
  printf '{"pid":%s,"startedAt":%s000,"command":["bun","install","--frozen-lockfile"]}' \
    $$ "$(date +%s)" >"$lock.$$"
  waited=0
  until ln "$lock.$$" "$lock" 2>/dev/null || [ "$waited" -gt 300 ]; do
    dead=$(holder "$lock")
    # A dead holder's lock is moved aside whole, which one waiter alone can do; a live lock moved by
    # a waiter that read the dead one before it goes back.
    if [ -n "$dead" ] && ! kill -0 "$dead" 2>/dev/null && mv "$lock" "$lock.$$.stale" 2>/dev/null; then
      [ "$(holder "$lock.$$.stale")" = "$dead" ] || ln "$lock.$$.stale" "$lock" 2>/dev/null
      rm -f "$lock.$$.stale"
      continue
    fi
    sleep 1
    waited=$((waited + 1))
  done
  rm -f "$lock.$$"
  if [ "$(holder "$lock")" = $$ ]; then
    trap 'rm -f "$log" "$lock"' EXIT
    bun install --frozen-lockfile </dev/null >"$log" 2>&1
  else
    echo "[install] pid $(holder "$lock") still holds $lock after 300 s; not installing beside it" >"$log"
    false
  fi
fi
status=$?
if [ "$status" -ne 0 ]; then
  cat "$log" >&2
  echo "[install] bun install --frozen-lockfile did not run or failed (above): run it before your gate" >&2
fi
exit "$status"
