{
  "extends": ["./node_modules/@hackersandwizards/scaffolding/config/oxlint.json"],
  "plugins": ["typescript"],
  "env": { "browser": true, "node": true, "bun": true },
  "options": { "typeAware": true },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "**/dist/**",
    "**/.astro/**",
    "/.claude/**",
    "/.agents/**",
    "/.githooks/**"
  ],
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:(?:\\.\\./)+(?:components|catalog)|@hackersandwizards/documents/components)(?:/|$)",
                "message": "Keep scripts independent of components and the catalog."
              }
            ]
          }
        ]
      }
    }
  ]
}
