---
import Type from "./_Type.astro";
import DocHeader from "../../../components/DocHeader.astro";
import DocPriceTable from "../../../components/DocPriceTable.astro";
import { version } from "@hackersandwizards/brand/package.json";
import elements from "../../../brand-elements.json";
import catalogs from "@hackersandwizards/brand/catalogs.json";
import { name } from "@hackersandwizards/brand/verbal.json";
import { escapeHtml } from "../../../scripts/fill";

const { portal, anchors } = catalogs.find((c) => c.name === "Brand")!;
const TILES: [string, string, string][] = [
  [
    "label",
    "Label, eyebrow",
    '<span class="eyebrow">Training für ein Team</span><span class="label">Zeitraum</span>',
  ],
  [
    "pill",
    "Pill, type tag",
    '<span class="doc-tag">Angebot</span> <span class="chip">Remote</span>',
  ],
  [
    "card",
    "Card, accented",
    `<div class="card"><h4>Über ${escapeHtml(name.company)}</h4></div><div class="card accent"><h4>Erstellt für Musterwerk AG</h4></div>`,
  ],
  [
    "callout",
    "Callout, outcome",
    '<div class="callout"><span class="label">Kurz gesagt</span><p>Ein Satz.</p></div><div class="callout outcome"><p>Ein Team, das Agenten steuert.</p></div>',
  ],
  [
    "quote",
    "Quote",
    "<blockquote><p>„Der Plan stand, bevor die erste Zeile Code lief.“</p></blockquote>",
  ],
  [
    "table",
    "Ruled table",
    "<table><thead><tr><th>Leistung</th><th>Basis</th></tr></thead><tbody><tr><td>Training</td><td>2 Tage</td></tr></tbody></table>",
  ],
  [
    "link",
    "Link in text",
    '<p>Dann öffnet ihr <a href="https://example.com/">localhost:3000</a>.</p>',
  ],
  [
    "rule",
    "Bar under a chapter title in the handout, rule under the survey readout's figures",
    '<h3>Kapiteltitel<span class="hw-rule" data-variant="bar" aria-hidden="true"></span></h3>',
  ],
  [
    "strip",
    "Gradient strip over the header, the certificate and every slide of the survey readout",
    '<div class="hw-strip"></div>',
  ],
  [
    "button",
    "Button, the call link in the onepager's contact footer",
    '<a class="hw-button" href="https://example.com/call">Gespräch buchen</a>',
  ],
  ["code", "Code block", '<pre><code><span class="prompt">$</span> bun run check</code></pre>'],
  [
    "kpi",
    "Figure, at slide size in the survey readout",
    '<div class="hw-kpi"><span class="hw-kpi-value">87 %</span><span class="small muted">Rücklauf</span></div>',
  ],
];
const SAMPLES: Record<string, string> = {
  "section-label": '<span class="section-label" lang="de">Leistungen</span>',
  "margin-note":
    '<p><em>In the handout: a note in the margin beside the text, with a purple rule.</em> <a href="../handout/index.html">Open the handout</a></p>',
  "survey-readout": '<p><a href="../survey-readout/index.html">Open the survey readout</a></p>',
  facts: '<p><a href="../onepager/index.html">Open the onepager</a></p>',
  "pricing-note":
    "<p><em>On the onepager: a muted sentence in the small role under the price cards.</em></p>",
};
const exceptions = Object.entries(
  elements.exceptions as Record<string, string | { reason: string }>,
).map(([name, e]) => [name, typeof e === "string" ? e : e.reason] as const);
const CSS = `
.tiles { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-grid); }
.tile { padding: var(--space-grid); border: var(--rule) dashed var(--line-soft); break-inside: avoid; }
.tile-origin { font: var(--role-small); }
.exception { margin: var(--block-margin-loose); padding-left: var(--space-grid); border-left: var(--rule-accent) solid var(--result); break-inside: avoid; }`;
---

<Type title="Brand elements and exceptions" lang="en" css={CSS}>
  <DocHeader kind="Elements" lang="en" legal />
  <h1>Elements from brand</h1>
  <p class="subtitle">
    The rule, the variants and the night form are in the brand catalog. Here the elements are on
    paper, at this engine's print size, and brand-elements measures exactly these tiles against the
    rule.
  </p>
  <div class="tiles">
    {TILES.map(([name, title, sample]) => (
      <div class="tile" data-hw-tile={name} data-hw-version={version}>
        <p class="tile-origin">
          <span class="chip">from brand v{version}</span> <code>.hw-{name}</code>{" "}
          <a class="tile-link" href={portal + anchors!.element.replace("<element>", name)}>
            Catalog
          </a>
        </p>
        <div lang="de" set:html={sample} />
        <p class="small muted">{title}</p>
      </div>
    ))}
  </div>
  <h2>This engine's exceptions</h2>
  {exceptions.map(([name, reason]) => (
    <section class="exception" data-hw-exception={name}>
      <h3>{name}</h3>
      <p class="muted">{reason}</p>
      {name === "total-band" ? (
        <div lang="de">
          <DocPriceTable
            columns={[{ label: "Leistung" }, { label: "Betrag", num: true }]}
            rows={[{ item: "Training Agentic Engineering", cells: ["X.XXX,XX €"] }]}
            total={{ label: "Summe netto", figure: "XX.XXX,XX €" }}
          />
        </div>
      ) : (
        <Fragment set:html={SAMPLES[name] ?? ""} />
      )}
    </section>
  ))}
</Type>
