---
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import elements from "../brand-elements.json";
import { TYPES } from "./types";

const ROOT = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const TYPES_URL = `${ROOT}types/`;
const exceptions = Object.entries(
  elements.exceptions as Record<string, string | { reason: string }>,
).map(([name, e]) => [name, typeof e === "string" ? e : e.reason]);
---

<Home>
  <div class="foundations">
    {/* prettier-ignore */}
    <p>
      Three layers. <strong>Tokens</strong>: <code>tokens.css</code> gives each value from{" "}
      <code>@hackersandwizards/brand</code> a role. <strong>Base</strong>: <code>document.css</code>
      sets the page, the running heads and the elements every type and Markdown body uses.{" "}
      <strong>Components</strong> use only tokens and base, <strong>types</strong> only components.
      Each story sits on an A4 sheet at print size (<code>data-hw-scale="print"</code>).
    </p>
    <p>
      Each type as a whole page, as the engine prints it:
      {TYPES.map((t, i) => (
        <>
          {i > 0 && " · "}
          <a class="hw-link" href={`${TYPES_URL}${t.file}/index.html`} set:text={t.title} />
        </>
      ))}
    </p>
    {/* prettier-ignore */}
    <p>
      From brand: {elements.uses.map((name) => <code>hw-{name}</code>)}. Kept as the engine's own,
      each with its reason:
    </p>
    <ul>
      {exceptions.map(([name, reason]) => (
        <li>
          <code>{name}</code>: {reason}
        </li>
      ))}
    </ul>
    {/* prettier-ignore */}
    <p>
      <a class="hw-link" href={`${TYPES_URL}elements/index.html`}>The elements page</a> shows each as
      a tile, and <code>brand-elements</code> measures them there in <code>bun run check</code>.
    </p>
  </div>
</Home>

{/* Global: .foundations is this page's alone. */}
<style is:global>
  .foundations {
    margin-top: 1.5rem;
    max-width: 60rem;
    font-size: var(--text-ui);
    line-height: 1.6;
  }
  .foundations p,
  .foundations ul {
    margin: 0 0 0.75rem;
  }
  .foundations code + code {
    margin-left: 0.5rem;
  }
</style>
