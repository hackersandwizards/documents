---
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
import elements from "../brand-elements.json";
import { TYPES } from "./types";

const ROOT = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const TYPES_URL = `${ROOT}types/`;
const exceptions = Object.entries(
  elements.exceptions as Record<string, string | { reason: string }>,
).map(([name, e]) => [name, typeof e === "string" ? e : e.reason]);
---

<Home>
  {/* The published catalogs; aria-current marks this one. */}
  <nav slot="nav" class="hw-header-nav" aria-label="Main">
    <a class="hw-header-link" href="https://hackersandwizards.github.io/brand/">
      Brand
    </a>
    <a class="hw-header-link" href="https://hackersandwizards.github.io/slides/">
      Slides
    </a>
    <a class="hw-header-link" href={ROOT} aria-current="page">
      Documents
    </a>
    <a class="hw-header-link" href="https://hackersandwizards.github.io/mail/">
      Mail
    </a>
  </nav>
  <div class="foundations">
    {/* prettier-ignore */}
    <p>
      Drei Ebenen. <strong>Tokens</strong>: <code>tokens.css</code> gibt jedem Wert eine Rolle aus{" "}
      <code>@hackersandwizards/brand</code>. <strong>Basis</strong>: <code>document.css</code> setzt
      Seite, Laufkopf und die Elemente, die jeder Typ und jeder Markdown-Text nutzt.{" "}
      <strong>Komponenten</strong> setzen sich nur aus Tokens und Basis zusammen,{" "}
      <strong>Typen</strong> nur aus Komponenten. Jede Story steht im Druckmaß
      (<code>data-hw-scale="print"</code>) auf einem A4-Blatt.
    </p>
    <p>
      Jeder Typ als ganze Seite, so wie die Engine ihn druckt:
      {TYPES.map((t, i) => (
        <>
          {i > 0 && " · "}
          <a class="hw-link" href={`${TYPES_URL}${t.file}/index.html`}>
            {t.title}
          </a>
        </>
      ))}
    </p>
    {/* prettier-ignore */}
    <p>
      Aus brand: {elements.uses.map((name) => <code>hw-{name}</code>)}. Als eigene behalten, jede mit
      ihrem Grund:
    </p>
    <ul>
      {exceptions.map(([name, reason]) => (
        <li>
          <code>{name}</code>: {reason}
        </li>
      ))}
    </ul>
    {/* prettier-ignore */}
    <p>
      <a class="hw-link" href={`${TYPES_URL}elemente/index.html`}>Die Elementseite</a> zeigt jedes als
      Kachel; dort misst <code>brand-elements</code> sie in <code>bun run check</code>.
    </p>
  </div>
</Home>

{/* Global, so Astro stamps no scope attribute on the header links; .foundations is this page's alone. */}
<style is:global>
  .foundations {
    margin-top: 1.5rem;
    max-width: 60rem;
    font-size: var(--text-ui);
    line-height: 1.6;
  }
  .foundations p,
  .foundations ul {
    margin: 0 0 0.75rem;
  }
  .foundations code + code {
    margin-left: 0.5rem;
  }
</style>
