---
// Astrobook's args cannot fill a slot, so a slotted component's story passes its slots as props.
interface Props {
  of: (props: Record<string, unknown>) => unknown;
  html: string;
  aside?: string;
  [prop: string]: unknown;
}
const { of: Component, html, aside, ...props } = Astro.props;
---

<Component {...props}>
  <Fragment set:html={html} />
  {aside && <Fragment slot="aside" set:html={aside} />}
</Component>
