---
// The readout's type page, which links the brand files: a srcdoc frame cannot resolve a relative
// link, so it would inline every face.
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/types/survey-readout/index.html`;
---

<iframe src={src} title="Survey Readout"></iframe>

<style>
  iframe {
    display: block;
    width: 1280px;
    height: 5208px;
    border: 0;
    /* A window narrower than the slides, the home's tile, shows them whole. */
    zoom: min(1, calc(100vw / 1280px));
  }
</style>
