{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "design-system/**/*.ts", "*.ts", "*.js"],
  "exclude": ["**/.astro"]
}
