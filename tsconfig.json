{
  "extends": "@hackersandwizards/scaffolding/tsconfig/bun.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/**/*.astro",
    "catalog/**/*.astro",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "catalog/**/*.ts",
    "*.ts",
    "*.js"
  ],
  "exclude": ["**/.astro", "dist", "**/node_modules"]
}
